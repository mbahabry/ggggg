# انسخ هذا الملف باسم .env وعدّل القيم عند الحاجة
# Copy this file to .env and adjust values as needed

# رابط الاتصال بقاعدة بيانات PostgreSQL (يعمل تلقائيا مع docker-compose.yml)
DATABASE_URL="postgresql://fleet_user:fleet_password@localhost:5432/fleetdb?schema=public"

# عنوان التطبيق (NextAuth)
NEXTAUTH_URL="http://localhost:3000"

# مفتاح سري لتشفير الجلسات - يمكن توليده عبر: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-random-secret-value"
